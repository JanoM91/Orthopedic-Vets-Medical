# Copia este archivo a .env y llena los valores. NUNCA subas .env a git.
# En Vercel, todo lo que NO empieza con NEXT_PUBLIC_ va como «Sensitive».

# --- Obligatorias ---
# Postgres de Supabase: rol payload_app por el pooler en modo transacción (puerto 6543).
# Ojo: este proyecto vive en el clúster aws-0 (con aws-1 responde «tenant/user not found»).
DATABASE_URL=postgresql://payload_app.REF:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
# Genera uno nuevo: openssl rand -hex 32. Nunca reutilices el de otra instalación.
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://tu-dominio
NEXT_PUBLIC_SITE_NAME=Veterinaria Exkalibur
NEXT_PUBLIC_LOCATION_CITY=Xalapa
NEXT_PUBLIC_LOCATION_TIMEZONE=America/Mexico_City

# --- Comprobantes (almacén PRIVADO de Vercel Blob) ---
FINANZAS_BLOB_READ_WRITE_TOKEN=

# --- Nota de voz (Anthropic). El dictado lo hace el teléfono; Claude interpreta el texto.
# Sin esta llave, la nota de voz dice que no está configurada y lo demás funciona igual ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Correo de «Olvidé mi contraseña» (Resend). Sin estas dos, no se envía ---
RESEND_API_KEY=
LEADS_FROM_EMAIL=

# --- Marca blanca del portal del tutor (opcionales; colores en #rrggbb) ---
# NEXT_PUBLIC_BRAND_PRIMARY=#123a34
# NEXT_PUBLIC_BRAND_ACCENT=#2bae8e
# NEXT_PUBLIC_BRAND_LOGO=/logo-mark-white.png
# NEXT_PUBLIC_BRAND_PHONE=228 000 0000

# --- Documentos del expediente (almacén PRIVADO de Vercel Blob). Si falta, usa FINANZAS_BLOB_READ_WRITE_TOKEN ---
CLINICA_BLOB_READ_WRITE_TOKEN=
